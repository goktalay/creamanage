# CreaManage servis ayarları — /etc/creamanage/creamanage.env
# Değiştirdikten sonra: sudo systemctl restart creamanage
CREAMANAGE_HOST=0.0.0.0
CREAMANAGE_PORT=8090
CREAMANAGE_VERITABANI=/var/lib/creamanage/creamanage.sqlite
CREAMANAGE_TELEMETRI=/var/lib/creamanage/telemetri
CREAMANAGE_TELEMETRI_GUN=30
CREAMANAGE_DOSYALAR=/var/lib/creamanage/dosyalar
CREAMANAGE_HATA_KODLARI=/var/lib/creamanage/hata_kodlari.json
CREAMANAGE_LOG=INFO
# Telegram API'ye vekil gerekiyorsa (isteğe bağlı):
# HTTPS_PROXY=http://vekil:3128
